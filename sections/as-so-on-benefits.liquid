{% comment %}
  As Seen On & Benefits Section
{% endcomment %}
<section class="as-seen-on-benefits-section">
  <div class="as-seen-on-bar">
    <span class="as-seen-on-label">AS SEEN ON</span>
    <span class="as-seen-on-divider"></span>
    <div class="as-seen-on-logos">
      {% for block in section.blocks %}
        {% if block.type == 'logo' %}
          <img class="as-seen-on-logo" src="{{ block.settings.logo | image_url: width: 1600 }}">
        {% endif %}
      {% endfor %}
    </div>
  </div>
  <div class="benefits-bar">
    {% for block in section.blocks %}
      {% if block.type == 'benefit' %}
        <div class="benefit-item">
          <img class="benefit-icon" src="{{ block.settings.icon-svg | image_url: width: 1600 }}">
          <div class="benefit-title">{{ block.settings.title }}</div>
          <div class="benefit-desc">{{ block.settings.desc }}</div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "As Seen On & Benefits",
  "max_blocks": 10,
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text",
          "default": "Media logo"
        }
      ]
    },
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon-svg",
          "label": "SVG Icon (inline SVG markup)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "NATURAL & SAFE"
        },
        {
          "type": "text",
          "id": "desc",
          "label": "Description",
          "default": "Carefully crafted with 100% natural botanicals"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "As Seen On & Benefits",
      "blocks": [
        { "type": "logo", "settings": { "alt": "Business Insider" } },
        { "type": "logo", "settings": { "alt": "Fox" } },
        { "type": "logo", "settings": { "alt": "NBC News" } },
        { "type": "logo", "settings": { "alt": "CBS" } },
        { "type": "logo", "settings": { "alt": "StreetInsider.com" } },
        { "type": "logo", "settings": { "alt": "Newsmax" } },
        { "type": "benefit", "settings": { "title": "NATURAL & SAFE", "desc": "Carefully crafted with 100% natural botanicals" } },
        { "type": "benefit", "settings": { "title": "MADE IN USA", "desc": "Products made in USA in cGMP Compliant Facilities" }},
        { "type": "benefit", "settings": { "title": "INTIMACY IS PRICELESS", "desc": "An affordable solution to regenerative health" }}
      ]
    }
  ]
}
{% endschema %}

<style>
.as-seen-on-benefits-section {
  border-radius: 28px;
  overflow: hidden;
  margin: 32px 0;
  font-family: inherit;
  max-width: 1360px;
  margin: 32px auto;
}
.as-seen-on-bar {
  background: #f7f7f7;
  padding: 51px 54px 43px;
  display: flex;
  align-items: center;
  gap: 24px;
  /* flex-wrap: wrap; */
  justify-content: flex-start;
}
.as-seen-on-label {
  font-weight: 700;
  font-size: 1.2rem;
  letter-spacing: 0.05em;
}
.as-seen-on-divider {
  width: 2px;
  height: 32px;
  background: #0a4d4d;
  margin: 0 16px;
  display: inline-block;
}
.as-seen-on-logos {
  display: flex;
  align-items: center;
  gap: 32px;
  width: 80%;
}
  img.as-seen-on-logo {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
.as-seen-on-logo img {
  max-height: 32px;
  width: auto;
  display: block;
  filter: grayscale(1) contrast(1.2);
}
.benefits-bar {
  background: #024F45;
  display: flex;
  justify-content: space-around;
  align-items: stretch;
  padding: 3.65vw 5.99vw;
  gap: 16px;
  flex-wrap: wrap;
}
.benefit-item {
  flex: 1 1 240px;
  max-width: 340px;
  min-width: 200px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  color: #fff;
  margin: 0 8px;
}
.benefit-icon {
  margin-bottom: 18px;
  display: block;
  width: 99px;
}
.benefit-title {
    color: #fff;
    font-family: "Cera Pro";
    font-size: 30px;
    font-style: normal;
    font-weight: 700;
    line-height: normal;
    text-align: center;
}
.benefit-desc {
  font-size: 1.05rem;
  font-weight: 400;
  color: #e0e0e0;
}
@media (max-width: 900px) {
  .benefits-bar {
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }
  .benefit-item {
    max-width: 100%;
  }
  .as-seen-on-bar {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .as-seen-on-logos {
    gap: 16px;
  }
}
</style> 