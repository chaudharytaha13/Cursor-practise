  <style>
    .banner-hero-section {
      min-height: 480px;
      background-size: cover;
      background-position: center;
      color: #fff;
      position: relative;
      overflow: hidden;
      padding: 0;
      display: flex;
      align-items: center;
    }
    .banner-hero-inner {
      display: flex;
      /* align-items: center; */
      max-width: 1440px;
      margin: 0 auto;
      padding: 120px 40px 40px 40px;
      min-height: 680px;
      width: 100%;
    }
    .banner-hero-left {
      flex: 1 1 100%;
      max-width: 540px;
      z-index: 2;
      text-align: left;
    }
    .banner-hero-heading {
      font-size: 3.8rem;
      font-weight: 700;
      margin-bottom: 20px;
      line-height: 1.1;
      text-align: left;
    }
    .banner-hero-heading .highlight {
      font-weight: 700;
      font-size: 2.8rem;
      display: inline-block;
      background: linear-gradient(90deg, #e3b04b 0%, #bfa14a 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      text-fill-color: transparent;
    }
    .banner-hero-rating-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 32px;
      /* flex-wrap: wrap; */
    }
    .banner-hero-avatars {
      display: flex;
      align-items: center;
      margin-right: 10px;
    }
    .banner-hero-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 2px solid #fff;
      margin-left: -10px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      background: #fff;
      object-fit: cover;
    }
    .banner-hero-avatar:first-child {
      margin-left: 0;
    }
    .banner-hero-stars {
      color: #e3b04b;
      font-size: 1.3rem;
      margin-right: 4px;
      letter-spacing: 1px;
    }
    .banner-hero-rating-value {
      font-weight: 700;
      font-size: 1.1rem;
      margin-right: 8px;
    }
    .banner-hero-review-count {
      font-weight: 700;
      font-size: 1.1rem;
      color: #fff;
      margin-right: 4px;
      display: flex;
      gap: 10px;
      align-items: center;
    }
    .banner-hero-review-label {
      color: #fff;
      font-weight: 700;
    }
    .banner-hero-check {
      color: #e3b04b;
      font-size: 1.2rem;
      margin-left: 4px;
    }
    .banner-hero-cta {
      display: flex;
      margin-top: 20px;
      padding: 16px 40px;
      font-size: 1.25rem;
      font-weight: 700;
      color: #0d4c3b;
      background: linear-gradient(90deg, #e3b04b 0%, #bfa14a 100%);
      border: none;
      border-radius: 32px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      cursor: pointer;
      text-decoration: none;
      transition: background 0.2s, color 0.2s;
      width: 320px;
      gap: 20px;
    }
    .banner-hero-cta .arrow {
      width: 20px;
      height: 2px;
      position: static;
      transition: 0.2s;
    }
    .banner-hero-cta:hover {
      background: #0d4c3b;
      color: #fff;
    }
    .banner-hero-cta:hover .arrow{
      margin-left: 10px;
    }
    @media (max-width: 900px) {
      .banner-hero-inner {
        flex-direction: column;
        align-items: flex-start;
        padding: 40px 10px 30px 10px;
        min-height: 0;
      }
      .banner-hero-left {
        max-width: 100%;
        width: 100%;
      }
    }
    @media (max-width: 600px) {
      .banner-hero-inner {
        padding: 24px 0 16px 0;
      }
      .banner-hero-heading {
        font-size: 1.5rem;
      }
      .banner-hero-heading .highlight {
        font-size: 1.5rem;
      }
    }
  </style>
</section> 