{% schema %}
{
  "name": "Before and After Slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Before and After Comparison"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before Image"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After Image"
    }
  ],
  "presets": [
    {
      "name": "Before and After Slider"
    }
  ]
}
{% endschema %}

<section class="before-after-section">
  {% if section.settings.heading != blank %}
    <h2 class="before-after-heading">{{ section.settings.heading }}</h2>
  {% endif %}
  <div class="before-after-slider-wrapper">
    <div class="before-after-slider" id="beforeAfterSlider-{{ section.id }}">
      {% if section.settings.before_image != blank %}
        <img src="{{ section.settings.before_image | img_url: 'master' }}" alt="Before" class="before-image" />
      {% endif %}
      {% if section.settings.after_image != blank %}
        <img src="{{ section.settings.after_image | img_url: 'master' }}" alt="After" class="after-image" />
      {% endif %}
      <div class="slider-handle"></div>
      <span class="label before-label">Before</span>
      <span class="label after-label">After</span>
    </div>
  </div>
  <style>
    .before-after-section {
      max-width: 700px;
      margin: 0 auto;
      padding: 40px 20px;
      text-align: center;
    }
    .before-after-heading {
      margin-bottom: 30px;
    }
    .before-after-slider-wrapper {
      position: relative;
      width: 100%;
      max-width: 600px;
      margin: 0 auto;
    }
    .before-after-slider {
      position: relative;
      width: 100%;
      aspect-ratio: 16/9;
      overflow: hidden;
      user-select: none;
      background: #f3f3f3;
    }
    .before-after-slider img {
      position: absolute;
      top: 0; left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      pointer-events: none;
    }
    .before-after-slider .after-image {
      clip-path: inset(0 0 0 50%);
      transition: clip-path 0.2s;
    }
    .slider-handle {
      position: absolute;
      top: 0; left: 50%;
      width: 4px;
      height: 100%;
      background: #fff;
      border: 2px solid #333;
      border-radius: 2px;
      cursor: ew-resize;
      z-index: 2;
      transition: left 0.2s;
    }
    .label {
      position: absolute;
      top: 10px;
      background: rgba(0,0,0,0.6);
      color: #fff;
      padding: 4px 12px;
      border-radius: 4px;
      font-size: 14px;
      z-index: 3;
      pointer-events: none;
    }
    .before-label {
      left: 20px;
    }
    .after-label {
      right: 20px;
    }
  </style>
  <script>
    (function() {
      var slider = document.getElementById('beforeAfterSlider-{{ section.id }}');
      if (!slider) return;
      var handle = slider.querySelector('.slider-handle');
      var afterImg = slider.querySelector('.after-image');
      var dragging = false;
      var sliderRect, startX;

      function setSlider(x) {
        var percent = Math.max(0, Math.min(1, (x - sliderRect.left) / sliderRect.width));
        var left = percent * 100;
        handle.style.left = left + '%';
        afterImg.style.clipPath = 'inset(0 0 0 ' + left + '%)';
      }

      function onDown(e) {
        dragging = true;
        sliderRect = slider.getBoundingClientRect();
        startX = (e.touches ? e.touches[0].clientX : e.clientX);
        document.addEventListener('mousemove', onMove);
        document.addEventListener('touchmove', onMove, {passive: false});
        document.addEventListener('mouseup', onUp);
        document.addEventListener('touchend', onUp);
      }
      function onMove(e) {
        if (!dragging) return;
        var x = (e.touches ? e.touches[0].clientX : e.clientX);
        setSlider(x);
        if (e.touches) e.preventDefault();
      }
      function onUp() {
        dragging = false;
        document.removeEventListener('mousemove', onMove);
        document.removeEventListener('touchmove', onMove);
        document.removeEventListener('mouseup', onUp);
        document.removeEventListener('touchend', onUp);
      }
      handle.addEventListener('mousedown', onDown);
      handle.addEventListener('touchstart', onDown, {passive: false});
      // Set initial position
      setSlider(slider.getBoundingClientRect().left + slider.offsetWidth / 2);
    })();
  </script>
</section> 