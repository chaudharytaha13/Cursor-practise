{% comment %}
  Custom Footer Section
{% endcomment %}
<section class="custom-footer-section">
  <div class="custom-footer-container">
    <div class="custom-footer-col custom-footer-col--links">
      <div class="custom-footer-title">SUPPLEMENTS</div>
      <ul class="custom-footer-list">
        {% for block in section.blocks %}
          {% if block.type == 'supplement' %}
            <li>
              <a href="{{ block.settings.url }}">{{ block.settings.label }}</a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
    <div class="custom-footer-col custom-footer-col--links">
      <div class="custom-footer-title">POLICIES</div>
      <ul class="custom-footer-list">
        {% for block in section.blocks %}
          {% if block.type == 'policy' %}
            <li>
              <a href="{{ block.settings.url }}">{{ block.settings.label }}</a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
    <div class="custom-footer-col custom-footer-col--brand">
      <div class="custom-footer-socials">
        {% for block in section.blocks %}
          {% if block.type == 'social' %}
            <a href="{{ block.settings.url }}" class="custom-footer-social-icon" target="_blank" rel="noopener">
              {{ block.settings.icon_svg }}
            </a>
          {% endif %}
        {% endfor %}
      </div>
      <hr class="custom-footer-divider">
      <div class="custom-footer-brand">{{ section.settings.brand_name }}</div>
      <div class="custom-footer-disclaimer">{{ section.settings.disclaimer }}</div>
      {% if section.settings.payment_img != blank %}
        <div class="custom-footer-payments">
          <img src="{{ section.settings.payment_img | image_url: width: 220 }}" alt="Payment Methods">
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "Natural Jackson"
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer Text",
      "default": "*THESE STATEMENTS HAVE NOT BEEN EVALUATED BY THE FOOD AND DRUG ADMINISTRATION. THESE PRODUCTS ARE NOT INTENDED TO DIAGNOSE, TREAT, CURE, OR PREVENT ANY DISEASE. READ OUR MEDICAL DISCLAIMER."
    },
    {
      "type": "image_picker",
      "id": "payment_img",
      "label": "Payment Methods Image"
    }
  ],
  "max_blocks": 20,
  "blocks": [
    {
      "type": "supplement",
      "name": "Supplement Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "ROCKETWOOD"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        }
      ]
    },
    {
      "type": "policy",
      "name": "Policy Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "PRIVACY POLICY"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        }
      ]
    },
    {
      "type": "social",
      "name": "Social Icon",
      "settings": [
        {
          "type": "textarea",
          "id": "icon_svg",
          "label": "SVG Icon (inline SVG markup)",
          "default": "<svg width='36' height='36' fill='none' xmlns='http://www.w3.org/2000/svg'><circle cx='18' cy='18' r='18' fill='#D6B36A'/><path d='M24 12h-2a2 2 0 0 0-2 2v2h4l-1 4h-3v8h-4v-8h-2v-4h2v-2a4 4 0 0 1 4-4h2v4z' fill='#0A4D4D'/></svg>"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Social Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Footer",
      "blocks": [
        { "type": "supplement", "settings": { "label": "ROCKETWOOD" } },
        { "type": "supplement", "settings": { "label": "EVERWOOD" } },
        { "type": "supplement", "settings": { "label": "TOTAL PACKAGE" } },
        { "type": "supplement", "settings": { "label": "VITALITY BUNDLE" } },
        { "type": "policy", "settings": { "label": "PRIVACY POLICY" } },
        { "type": "policy", "settings": { "label": "TERMS OF SERVICE" } },
        { "type": "policy", "settings": { "label": "SHIPPING POLICY" } },
        { "type": "policy", "settings": { "label": "REFUND POLICY" } },
        { "type": "policy", "settings": { "label": "MEDICAL DISCLAIMER" } },
        { "type": "social" },
        { "type": "social" },
        { "type": "social" },
        { "type": "social" }
      ]
    }
  ]
}
{% endschema %}

<style>
  .custom-footer-section {
    background: #024f45;
    color: #fff;
    padding: 80px 40px;
    font-family: inherit;
  }
  .custom-footer-container {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr auto;
    row-gap: 0;
  }
  .custom-footer-col {
    width: 100%;
            max-width: fit-content;

  }
  .custom-footer-col--brand {
    flex: 1 1 320px;
    min-width: 260px;
    max-width: 340px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
  }
  .custom-footer-title {
    font-size: 2.22vw;
    font-weight: 700;
    font-size: 2.22vw;
    white-space: nowrap;
    text-align: center;
    margin-bottom: 40px;

  }
  .custom-footer-list {
    list-style: none;
    padding: 0;
    margin: 0;
    text-align: center;
  }
  .custom-footer-list li {
    margin-top: 20px;
    font-size: 1.6rem;
  }
  .custom-footer-list a {
    color: #d3d3d3;
    font-family: Cera Pro;
    font-size: 16px;
    font-style: normal;
    font-weight: 500;
    line-height: normal;
    text-decoration: none;
    transition: color 0.2s;
  }
  .custom-footer-list a:hover {
    color: #d6b36a;
  }
  .custom-footer-socials {
    display: flex;
    gap: 18px;
    margin-bottom: 12px;
  }
  .custom-footer-social-icon svg {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: none;
    transition: background 0.2s;
  }
  .custom-footer-social-icon:hover svg circle {
    fill: #fff;
  }
  .custom-footer-divider {
    width: 100%;
    border: none;
    border-top: 2px solid #b7c6b6;
    margin: 16px 0 12px 0;
  }
  .custom-footer-brand {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .custom-footer-disclaimer {
    font-size: 0.93rem;
    color: #b7c6b6;
    margin-bottom: 18px;
    font-weight: 600;
    line-height: 1.3;
  }
  .custom-footer-payments img {
    width: 220px;
    max-width: 100%;
    border-radius: 10px;
    background: #39736b;
    padding: 8px 12px;
    margin-top: 6px;
  }
  @media (max-width: 900px) {
    .custom-footer-container {
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
    }
    .custom-footer-col {
      min-width: 0;
      max-width: 100%;
    }
    .custom-footer-col--brand {
      min-width: 0;
      max-width: 100%;
    }
  }
</style>
