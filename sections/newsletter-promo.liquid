{% comment %}
  Newsletter Promo Section
{% endcomment %}
<section class="newsletter-promo-section">
  <div class="newsletter-promo-container">
    <div class="newsletter-promo-left">
      {% if section.settings.left_image != blank %}
        <img
          class="newsletter-promo-img"
          src="{{ section.settings.left_image | image_url: width: 500 }}"
          alt="{{ section.settings.left_image_alt }}"
        >
      {% endif %}
    </div>
    <div class="newsletter-promo-right">
      <h2 class="newsletter-promo-heading">
        {{ section.settings.heading }}
        <span class="newsletter-promo-highlight">{{ section.settings.highlight }}</span>
        {{ section.settings.heading_after }}
      </h2>
      <div class="newsletter-promo-subheading">{{ section.settings.subheading }}</div>
      <div class="newsletter-promo-form-section">
        <form method="post" action="/contact#newsletter-promo" accept-charset="UTF-8" class="newsletter-promo-form">
          <input type="hidden" name="form_type" value="customer">
          <input type="hidden" name="utf8" value="✓">
          <input
            type="email"
            name="contact[email]"
            class="newsletter-promo-input"
            placeholder="Your E-mail Here"
            required
          >
          <button type="submit" class="newsletter-promo-btn">
            {{ section.settings.button_text }}
            <!-- <span class="newsletter-promo-btn-arrow">→</span> -->
            <svg
              class="newsletter-promo-btn-arrow"
              xmlns="http://www.w3.org/2000/svg"
              width="23"
              height="24"
              viewBox="0 0 23 24"
              fill="none"
            >
              <path d="M22.9958 12.3479C23.0034 11.8837 22.8477 11.4324 22.5573 11.0768V11.0668L14.9813 0.775139C14.83 0.569827 14.6408 0.397461 14.4245 0.267551C14.2082 0.137641 13.9691 0.0529133 13.7208 0.0182933C13.4726 -0.0163267 13.2202 -0.000403711 12.9781 0.0655663C12.7359 0.131536 12.5088 0.246224 12.3098 0.402685C11.9072 0.716981 11.6421 1.1824 11.5724 1.6972C11.5027 2.212 11.6342 2.73437 11.938 3.14977L17.2638 10.3706H1.90827C1.40216 10.3706 0.916805 10.5775 0.558935 10.9455C0.201066 11.3135 0 11.8123 0 12.3327C0 12.8531 0.201066 13.3523 0.558935 13.7203C0.916805 14.0883 1.40216 14.2952 1.90827 14.2952H16.8007L16.1349 15.0215L10.9394 20.6938C10.7677 20.8816 10.6337 21.1021 10.545 21.3432C10.4563 21.5843 10.4147 21.841 10.4224 22.0986C10.4302 22.3562 10.4873 22.61 10.5903 22.8449C10.6934 23.0799 10.8404 23.2916 11.0231 23.4681C11.2057 23.6446 11.4204 23.7823 11.6549 23.8735C11.8893 23.9647 12.1389 24.0075 12.3895 23.9995C12.64 23.9916 12.8866 23.9331 13.1151 23.8272C13.3436 23.7212 13.5495 23.57 13.7212 23.3821L22.0038 14.3439L22.4841 13.8234C22.663 13.6265 22.8008 13.3944 22.8888 13.1406C22.9768 12.8868 23.0132 12.6168 22.9958 12.3479Z" fill="white"></path>
            </svg>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter Promo",
  "settings": [
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left Image"
    },
    {
      "type": "text",
      "id": "left_image_alt",
      "label": "Left Image Alt Text",
      "default": "Newsletter Promo Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (before highlight)",
      "default": "Unlock "
    },
    {
      "type": "text",
      "id": "highlight",
      "label": "Highlight Text",
      "default": "10% OFF!"
    },
    {
      "type": "text",
      "id": "heading_after",
      "label": "Heading (after highlight)"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Join over 20,000+ members getting access to Performance Techniques, Tips & Tricks to supercharge your S/X life."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Sign Up"
    }
  ],
  "presets": [
    {
      "name": "Newsletter Promo"
    }
  ]
}
{% endschema %}

<style>
  .newsletter-promo-section {
    background: #fafafa;
    border-radius: 22px;
    margin: 36px 0;
    padding: 0;
    overflow: hidden;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
  }
  .newsletter-promo-container {
    display: flex;
    align-items: stretch;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 120px;
  }
  .newsletter-promo-left {
   width: 100%;
    max-width: 50%;
    border-radius: 16.047px 0px 0px 16.047px;
    overflow: hidden;
  }
  .newsletter-promo-img {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 0;
    display: block;
  }
  .newsletter-promo-right {
    flex: 1 1 340px;
    min-width: 240px;
    padding: 38px 32px 38px 32px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #fafafa;
  }
  .newsletter-promo-heading {
    font-size: 48px;
    margin-bottom: 24px;
    color: #024F45;
    font-family: "Cera Pro";
    font-weight: 700;
  }
  .newsletter-promo-highlight {
    color: #dec99e;
  }
  .newsletter-promo-subheading {
    font-size: 16px;
    font-weight: 500;
  }
  .newsletter-promo-form-section{
    padding: 32px;
  }
  .newsletter-promo-form {
    display: flex;
    align-items: center;
    gap: 0;
    background: #fff;
    border-radius: 32px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.04);
    padding: 0px 0 0px 48px;
    height: 70px;
    font-size: 20px;
    max-width: 100%;
  }
  .newsletter-promo-input {
    border: none;
    outline: none;
    font-size: 1.08rem;
    flex: 1 1 auto;
    background: transparent;
    padding: 10px 0;
    color: #222;
  }
  .newsletter-promo-input::placeholder {
    color: #b7c6b6;
    opacity: 1;
  }
  .newsletter-promo-btn {
    background: #0a4d4d;
    color: #fff;
    font-size: 1.1rem;
    font-weight: 700;
    border: none;
    border-radius: 50px;
    padding: 12px 32px;
    margin-left: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: background 0.2s;
    height: 100%;
    width: 100%;
    max-width: 200px;
  }
  .newsletter-promo-btn:hover .newsletter-promo-btn-arrow{
      transform: translate(10px);
  }
   .newsletter-promo-btn-arrow {
    font-size: 1.2em;
    margin-left: 2px;
    transition: all .4s;
  }
  .newsletter-promo-btn-arrow path{
    fill: #d2b06d;
  }
  @media (max-width: 900px) {
    .newsletter-promo-container {
      flex-direction: column;
    }
    .newsletter-promo-left, .newsletter-promo-right {
      max-width: 100%;
      min-width: 0;
      padding: 24px 12px;
    }
    .newsletter-promo-right {
      padding: 24px 12px;
    }
    .newsletter-promo-form {
      max-width: 100%;
    }
  }
</style>
