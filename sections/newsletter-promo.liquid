{% comment %}
  Newsletter Promo Section
{% endcomment %}
<section class="newsletter-promo-section">
  <div class="newsletter-promo-container">
    <div class="newsletter-promo-left">
      {% if section.settings.left_image != blank %}
        <img
          class="newsletter-promo-img"
          src="{{ section.settings.left_image | image_url: width: 500 }}"
          alt="{{ section.settings.left_image_alt }}"
        >
      {% endif %}
    </div>
    <div class="newsletter-promo-right">
      <h2 class="newsletter-promo-heading">
        {{ section.settings.heading }}
        <span class="newsletter-promo-highlight">{{ section.settings.highlight }}</span>
        {{ section.settings.heading_after }}
      </h2>
      <div class="newsletter-promo-subheading">{{ section.settings.subheading }}</div>
      <div class="newsletter-promo-form-section">
        <form method="post" action="/contact#newsletter-promo" accept-charset="UTF-8" class="newsletter-promo-form">
          <input type="hidden" name="form_type" value="customer">
          <input type="hidden" name="utf8" value="✓">
          <input
            type="email"
            name="contact[email]"
            class="newsletter-promo-input"
            placeholder="Your E-mail Here"
            required
          >
          <button type="submit" class="newsletter-promo-btn">
            {{ section.settings.button_text }}
            <span class="newsletter-promo-btn-arrow">→</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter Promo",
  "settings": [
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left Image"
    },
    {
      "type": "text",
      "id": "left_image_alt",
      "label": "Left Image Alt Text",
      "default": "Newsletter Promo Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (before highlight)",
      "default": "Unlock "
    },
    {
      "type": "text",
      "id": "highlight",
      "label": "Highlight Text",
      "default": "10% OFF!"
    },
    {
      "type": "text",
      "id": "heading_after",
      "label": "Heading (after highlight)"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Join over 20,000+ members getting access to Performance Techniques, Tips & Tricks to supercharge your S/X life."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Sign Up"
    }
  ],
  "presets": [
    {
      "name": "Newsletter Promo"
    }
  ]
}
{% endschema %}

<style>
  .newsletter-promo-section {
    background: #fafafa;
    border-radius: 22px;
    margin: 36px 0;
    padding: 0;
    overflow: hidden;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
  }
  .newsletter-promo-container {
    display: flex;
    align-items: stretch;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 120px;
  }
  .newsletter-promo-left {
   width: 100%;
    max-width: 50%;
    border-radius: 16.047px 0px 0px 16.047px;
    overflow: hidden;
  }
  .newsletter-promo-img {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 0;
    display: block;
  }
  .newsletter-promo-right {
    flex: 1 1 340px;
    min-width: 240px;
    padding: 38px 32px 38px 32px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #fafafa;
  }
  .newsletter-promo-heading {
    font-size: 48px;
    margin-bottom: 24px;
    color: #024F45;
    font-family: "Cera Pro";
    font-weight: 700;
  }
  .newsletter-promo-highlight {
    color: #dec99e;
  }
  .newsletter-promo-subheading {
    font-size: 16px;
    font-weight: 500;
  }
  .newsletter-promo-form-section{
    padding: 32px;
  }
  .newsletter-promo-form {
    display: flex;
    align-items: center;
    gap: 0;
    background: #fff;
    border-radius: 32px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.04);
    padding: 6px 8px 6px 18px;
    max-width: 100%;
  }
  .newsletter-promo-input {
    border: none;
    outline: none;
    font-size: 1.08rem;
    flex: 1 1 auto;
    background: transparent;
    padding: 10px 0;
    color: #222;
  }
  .newsletter-promo-input::placeholder {
    color: #b7c6b6;
    opacity: 1;
  }
  .newsletter-promo-btn {
    background: #0a4d4d;
    color: #fff;
    font-size: 1.1rem;
    font-weight: 700;
    border: none;
    border-radius: 32px;
    padding: 12px 32px;
    margin-left: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: background 0.2s;
  }
  .newsletter-promo-btn:hover {
    background: #093b3b;
  }
  .newsletter-promo-btn-arrow {
    font-size: 1.2em;
    margin-left: 2px;
  }
  @media (max-width: 900px) {
    .newsletter-promo-container {
      flex-direction: column;
    }
    .newsletter-promo-left, .newsletter-promo-right {
      max-width: 100%;
      min-width: 0;
      padding: 24px 12px;
    }
    .newsletter-promo-right {
      padding: 24px 12px;
    }
    .newsletter-promo-form {
      max-width: 100%;
    }
  }
</style>
