{% comment %}
  New Daily Intimacy Formula Benefits Section
  Fully customizable via theme editor
{% endcomment %}
<section class="nj-benefits-d6-section" style="background-image: url({{ section.settings.bg_image | image_url }}); background-size:cover; background-position:center;">
  <div class="nj-benefits-d6__container">
    <div class="nj-benefits-d6__header">
      <h2 style="color: {{ section.settings.heading_color }}">{{ section.settings.heading }}</h2>
      <p style="color: {{ section.settings.subheading_color }}">{{ section.settings.subheading }}</p>
    </div>
    <div class="nj-benefits-d6__content">
      <div class="nj-benefits-d6__benefits">
        {% for block in section.blocks %}
          <div class="nj-benefits-d6__benefit">
            <div class="nj-benefits-d6__icon">
              {% if block.settings.icon != blank %}
                <img src="{{ block.settings.icon | image_url }}" alt="icon" loading="lazy" />
              {% endif %}
            </div>
            <div class="nj-benefits-d6__text">
              <h3 style="color: {{ block.settings.title_color }}">{{ block.settings.title }}</h3>
              <p style="color: {{ block.settings.desc_color }}">{{ block.settings.desc }}</p>
            </div>
            {% if block.settings.arrow_img != blank %}
              <img class="nj-benefits-d6__arrow" src="{{ block.settings.arrow_img | image_url }}" alt="arrow" loading="lazy" />
            {% endif %}
          </div>
        {% endfor %}
      </div>
      <div class="nj-benefits-d6__center-image">
        {% if section.settings.center_image != blank %}
          <img src="{{ section.settings.center_image | image_url }}" alt="{{ section.settings.center_image_alt }}" loading="lazy" />
        {% endif %}
      </div>
    </div>
    <div class="nj-benefits-d6__cta">
      <a href="{{ section.settings.cta_link }}" class="nj-benefits-d6__cta-btn" style="background: {{ section.settings.cta_bg }}; color: {{ section.settings.cta_color }}">{{ section.settings.cta_label }}</a>
    </div>
  </div>
</section>

<style>
.nj-benefits-d6-section {
  padding: 48px 0;
  position: relative;
}
.nj-benefits-d6__container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 16px;
}
.nj-benefits-d6__header {
  text-align: center;
  margin-bottom: 32px;
}
.nj-benefits-d6__content {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  position: relative;
}
.nj-benefits-d6__benefits {
  display: flex;
  flex-direction: column;
  flex: 1 1 300px;
  gap: 32px;
  max-width: 400px;
}
.nj-benefits-d6__benefit {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  position: relative;
}
.nj-benefits-d6__icon img {
  width: 48px;
  height: 48px;
  object-fit: contain;
}
.nj-benefits-d6__arrow {
  position: absolute;
  right: -40px;
  top: 50%;
  transform: translateY(-50%);
  width: 40px;
  height: auto;
}
.nj-benefits-d6__center-image {
  flex: 0 0 320px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 32px;
}
.nj-benefits-d6__center-image img {
  max-width: 320px;
  width: 100%;
  height: auto;
  border-radius: 16px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.12);
}
.nj-benefits-d6__cta {
  text-align: center;
  margin-top: 40px;
}
.nj-benefits-d6__cta-btn {
  display: inline-block;
  padding: 16px 40px;
  border-radius: 32px;
  font-weight: bold;
  font-size: 1.2rem;
  text-decoration: none;
  transition: background 0.2s, color 0.2s;
}
@media (max-width: 900px) {
  .nj-benefits-d6__content {
    flex-direction: column;
  }
  .nj-benefits-d6__center-image {
    margin: 32px 0;
  }
  .nj-benefits-d6__benefits {
    max-width: 100%;
    flex: 1 1 100%;
  }
}
@media (max-width: 600px) {
  .nj-benefits-d6-section {
    padding: 24px 0;
  }
  .nj-benefits-d6__header h2 {
    font-size: 1.5rem;
  }
  .nj-benefits-d6__center-image img {
    max-width: 200px;
  }
  .nj-benefits-d6__cta-btn {
    padding: 12px 24px;
    font-size: 1rem;
  }
}
</style>

{% schema %}
{
  "name": "NJ Benefits D6",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Section Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Daily Intimacy Formula"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#F6E27A"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Scientifically-backed men's flow support that may improve vascularity and bedroom capacities"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#fff"
    },
    {
      "type": "image_picker",
      "id": "center_image",
      "label": "Center Product Image"
    },
    {
      "type": "text",
      "id": "center_image_alt",
      "label": "Center Image Alt Text",
      "default": "Everwood Product"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Button Label",
      "default": "Order Now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    },
    {
      "type": "color",
      "id": "cta_bg",
      "label": "CTA Button Background",
      "default": "#F6E27A"
    },
    {
      "type": "color",
      "id": "cta_color",
      "label": "CTA Button Text Color",
      "default": "#0A4D4D"
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Benefit Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Benefit Title",
          "default": "Promotes Blood Flow"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title Color",
          "default": "#fff"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Benefit Description",
          "default": "Contains botanicals traditionally used to support smooth blood flow, helping to sustain vascular wellness and overall male health."
        },
        {
          "type": "color",
          "id": "desc_color",
          "label": "Description Color",
          "default": "#fff"
        },
        {
          "type": "image_picker",
          "id": "arrow_img",
          "label": "Arrow Image (connects to center image)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "NJ Benefits D6",
      "blocks": [
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" }
      ]
    }
  ]
}
{% endschema %} 