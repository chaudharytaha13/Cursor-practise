{% comment %}
  Superior Daily Vitality Section
{% endcomment %}
<section class="superior-daily-vitality-section">
  <div class="sdv-container">
    <div class="sdv-left">
      {% if section.settings.left_image != blank %}
        <img class="sdv-product-image" src="{{ section.settings.left_image | image_url: width: 400 }}" alt="{{ section.settings.left_image_alt }}">
      {% endif %}
    </div>
    <div class="sdv-right">
      <h2 class="sdv-heading">{{ section.settings.heading }}</h2>
      <div class="sdv-subheading">{{ section.settings.subheading }}</div>
      <div class="sdv-ingredients-grid">
        {% for block in section.blocks %}
          {% if block.type == 'ingredient' %}
            <div class="sdv-ingredient-block" style="background: {{ block.settings.bg_color }};">
              <div class="sdv-ingredient-text">
                <div class="sdv-ingredient-title">{{ block.settings.title }}</div>
                <div class="sdv-ingredient-desc">{{ block.settings.desc }}</div>
              </div>
              {% if block.settings.image != blank %}
                <img class="sdv-ingredient-img" src="{{ block.settings.image | image_url: width: 80 }}" alt="{{ block.settings.title }}">
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
      <div class="sdv-badges-row">
        {% for block in section.blocks %}
          {% if block.type == 'badge' %}
            <div class="sdv-badge">
              <span class="sdv-badge-icon">{{ block.settings.icon_svg }}</span>
              <span class="sdv-badge-label">{{ block.settings.label }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Superior Daily Vitality",
  "settings": [
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Product Image"
    },
    {
      "type": "text",
      "id": "left_image_alt",
      "label": "Product Image Alt Text",
      "default": "Everwood Product"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Superior Daily Vitality"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Carefully crafted with Hormone Free, Gluten Free & Soy Free ingredients"
    }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Ingredient Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Horny Goat Weed"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description",
          "default": "Traditionally used to support healthy libido and promote overall intimate vitality."
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Background Color",
          "default": "#E9E3F7"
        }
      ]
    },
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "textarea",
          "id": "icon_svg",
          "label": "SVG Icon (inline SVG markup)",
          "default": "<svg width='24' height='24' fill='none' xmlns='http://www.w3.org/2000/svg'><circle cx='12' cy='12' r='12' fill='none' stroke='#D6B36A' stroke-width='2'/><path d='M8 12l2.5 2.5L16 9' stroke='#D6B36A' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/></svg>"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "HORMONE-FREE"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Superior Daily Vitality",
      "blocks": [
        { "type": "ingredient", "settings": { "title": "Horny Goat Weed", "desc": "Traditionally used to support healthy libido and promote overall intimate vitality.", "bg_color": "#E9E3F7" } },
        { "type": "ingredient", "settings": { "title": "Eriosema Kraussianum", "desc": "Commonly used in herbal traditions to promote male vigor and support intimate wellness.", "bg_color": "#E6F7D9" } },
        { "type": "ingredient", "settings": { "title": "Grapefruit Extract", "desc": "Provides antioxidants and nutrients like fiber and potassium to support immune and digestive health.", "bg_color": "#FFF3D9" } },
        { "type": "ingredient", "settings": { "title": "Yohimbine", "desc": "Traditionally used to support circulation and enhance physical performance.", "bg_color": "#FFE7D9" } },
        { "type": "ingredient", "settings": { "title": "Cat's Claw Extract", "desc": "Helps support energy levels, circulation, and physical performance, including intimate vitality.", "bg_color": "#FFE7D9" } },
        { "type": "ingredient", "settings": { "title": "Ginseng Root", "desc": "Helps support energy levels, circulation, and physical performance, including intimate vitality.", "bg_color": "#E6F7D9" } },
        { "type": "badge", "settings": { "label": "HORMONE-FREE" } },
        { "type": "badge", "settings": { "label": "cGMP COMPLIANT" } },
        { "type": "badge", "settings": { "label": "3rd PARTY TESTED" } },
        { "type": "badge", "settings": { "label": "VEGAN" } },
        { "type": "badge", "settings": { "label": "NON-GMO" } },
        { "type": "badge", "settings": { "label": "MADE IN USA" } }
      ]
    }
  ]
}
{% endschema %}

<style>
.superior-daily-vitality-section {
  margin: 40px 0;
  font-family: inherit;
}
.sdv-container {
  display: flex;
  gap: 32px;
  align-items: flex-start;
  justify-content: center;
  flex-wrap: wrap;
}
.sdv-left {
  flex: 0 0 340px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sdv-product-image {
  max-width: 320px;
  width: 100%;
  border-radius: 18px;
  box-shadow: 0 4px 32px rgba(0,0,0,0.10);
}
.sdv-right {
  flex: 1 1 480px;
  min-width: 320px;
  max-width: 700px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.sdv-heading {
  font-size: 2.2rem;
  font-weight: 700;
  margin-bottom: 8px;
  color: #222;
}
.sdv-subheading {
  font-size: 1.1rem;
  color: #444;
  margin-bottom: 28px;
}
.sdv-ingredients-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px 24px;
  margin-bottom: 32px;
  width: 100%;
}
.sdv-ingredient-block {
  border-radius: 16px;
  padding: 18px 18px 18px 18px;
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 120px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.04);
  position: relative;
  justify-content: space-between;
}
.sdv-ingredient-text {
  flex: 1 1 auto;
  min-width: 0;
}
.sdv-ingredient-img {
  width: 56px;
  height: 56px;
  object-fit: contain;
  border-radius: 12px;
  margin-left: 18px;
  position: absolute;
  right: 18px;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  box-shadow: none;
}
.sdv-ingredient-title {
  font-size: 1.1rem;
  font-weight: 700;
  margin-bottom: 4px;
  color: #222;
}
.sdv-ingredient-desc {
  font-size: 0.98rem;
  color: #333;
  font-weight: 400;
}
.sdv-badges-row {
  display: flex;
  flex-wrap: wrap;
  gap: 18px 24px;
  margin-top: 18px;
  align-items: center;
}
.sdv-badge {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 1.05rem;
  color: #222;
  font-weight: 600;
  background: #fff;
  border-radius: 18px;
  padding: 6px 16px 6px 10px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}
.sdv-badge-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
}
@media (max-width: 900px) {
  .sdv-container {
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }
  .sdv-left, .sdv-right {
    max-width: 100%;
    min-width: 0;
  }
  .sdv-ingredients-grid {
    grid-template-columns: 1fr;
  }
  .sdv-ingredient-block {
    flex-direction: row;
    padding-right: 80px;
  }
  .sdv-ingredient-img {
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
  }
}
</style> 