{% schema %}
{
  "name": "Testimonial Slider",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join Over 8,000+ Men Unlocking Lasting Confidence" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "While individual results may vary, many of our customers have experienced positive results every time!" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "text", "id": "stars", "label": "Star Rating (1-5)", "default": "5" },
        { "type": "text", "id": "title", "label": "Title", "default": "Better Focus" },
        { "type": "textarea", "id": "text", "label": "Testimonial Text", "default": "My productivity at work has skyrocketed since I started using Everwood. It helps me stay sharp all day." },
        { "type": "text", "id": "name", "label": "Name", "default": "Eleri S." },
        { "type": "text", "id": "badge", "label": "Badge", "default": "Verified Buyer" }
      ]
    }
  ],
  "presets": [ { "name": "Testimonial Slider" } ]
}
{% endschema %}

<section class="testimonial-slider-section">
  <div class="testimonial-slider-header">
    <h2 class="testimonial-slider-heading">{{ section.settings.heading }}</h2>
    <div class="testimonial-slider-subheading">{{ section.settings.subheading }}</div>
  </div>
  <div class="testimonial-slider-wrapper">
    <button class="testimonial-slider-arrow left" id="testimonialSliderPrev-{{ section.id }}" aria-label="Previous">&#8592;</button>
    <div class="testimonial-slider-track" id="testimonialSliderTrack-{{ section.id }}">
      {% for block in section.blocks %}
        <div class="testimonial-slide">
          <div class="testimonial-stars">
            {% assign star_count = block.settings.stars | plus: 0 %}
            {% for i in (1..5) %}
              {% if i <= star_count %}
                <span class="star filled">&#9733;</span>
              {% else %}
                <span class="star">&#9733;</span>
              {% endif %}
            {% endfor %}
          </div>
          <div class="testimonial-title">{{ block.settings.title }}</div>
          <div class="testimonial-text">{{ block.settings.text }}</div>
          <div class="testimonial-name">{{ block.settings.name }}</div>
          <div class="testimonial-badge"><span class="badge-icon">&#10003;</span> {{ block.settings.badge }}</div>
        </div>
      {% endfor %}
    </div>
    <button class="testimonial-slider-arrow right" id="testimonialSliderNext-{{ section.id }}" aria-label="Next">&#8594;</button>
  </div>
  <style>
    .testimonial-slider-section {
      max-width: 1100px;
      margin: 0 auto;
      padding: 40px 10px 60px 10px;
      text-align: center;
    }
    .testimonial-slider-header {
      margin-bottom: 18px;
    }
    .testimonial-slider-heading {
      font-size: 2.3rem;
      font-weight: 700;
      margin-bottom: 8px;
    }
    .testimonial-slider-subheading {
      color: #4a5a5a;
      font-size: 1.1rem;
      margin-bottom: 24px;
    }
    .testimonial-slider-wrapper {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0;
      position: relative;
    }
    .testimonial-slider-arrow {
      background: #f7f7f7;
      border: none;
      border-radius: 50%;
      width: 40px;
      height: 40px;
      font-size: 1.5rem;
      color: #06584d;
      cursor: pointer;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s, color 0.2s;
      z-index: 2;
    }
    .testimonial-slider-arrow:hover {
      background: #06584d;
      color: #fff;
    }
    .testimonial-slider-track {
      display: flex;
      gap: 32px;
      transition: transform 0.5s cubic-bezier(.77,0,.18,1);
      width: 100%;
      max-width: 900px;
      overflow: hidden;
      justify-content: center;
    }
    .testimonial-slide {
      background: #b2d0cb;
      border-radius: 16px;
      min-width: 270px;
      max-width: 320px;
      flex: 0 0 320px;
      padding: 32px 18px 28px 18px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.04);
      text-align: center;
      opacity: 0.7;
      transform: scale(0.92);
      transition: box-shadow 0.3s, background 0.3s, opacity 0.3s, transform 0.3s;
      z-index: 1;
      position: relative;
      margin: 0 0;
    }
    .testimonial-slide.active {
      background: #06584d;
      color: #fff;
      box-shadow: 0 8px 32px rgba(0,0,0,0.13);
      opacity: 1;
      transform: scale(1.07);
      z-index: 2;
    }
    .testimonial-stars {
      margin-bottom: 18px;
      font-size: 1.5rem;
      color: #e3b04b;
    }
    .testimonial-title {
      font-size: 1.3rem;
      font-weight: 700;
      margin-bottom: 12px;
    }
    .testimonial-text {
      font-size: 1rem;
      margin-bottom: 22px;
      color: inherit;
    }
    .testimonial-name {
      font-weight: 700;
      font-size: 1.1rem;
      margin-bottom: 2px;
    }
    .testimonial-badge {
      color: #fff;
      font-size: 1rem;
      opacity: 0.85;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }
    .testimonial-slide .badge-icon {
      color: #e3b04b;
      font-size: 1.1em;
    }
    @media (max-width: 900px) {
      .testimonial-slider-track {
        gap: 12px;
        max-width: 98vw;
      }
      .testimonial-slide {
        min-width: 220px;
        max-width: 260px;
        flex: 0 0 260px;
        padding: 22px 8px 18px 8px;
      }
    }
    @media (max-width: 600px) {
      .testimonial-slider-section {
        padding: 20px 0 30px 0;
      }
      .testimonial-slider-heading {
        font-size: 1.2rem;
      }
      .testimonial-slide {
        min-width: 90vw;
        max-width: 95vw;
        flex: 0 0 95vw;
        padding: 16px 2vw 14px 2vw;
      }
    }
  </style>
  <script>
    (function() {
      var sectionId = '{{ section.id }}';
      var track = document.getElementById('testimonialSliderTrack-' + sectionId);
      var slides = Array.from(track.querySelectorAll('.testimonial-slide'));
      var prevBtn = document.getElementById('testimonialSliderPrev-' + sectionId);
      var nextBtn = document.getElementById('testimonialSliderNext-' + sectionId);
      var total = slides.length;
      if (total < 1) return;
      var center = 1;
      // Clone slides for infinite loop
      function renderSlides() {
        track.innerHTML = '';
        var visible = 3;
        for (var i = -1; i <= 1; i++) {
          var idx = (center + i + total) % total;
          var slide = slides[idx].cloneNode(true);
          if (i === 0) slide.classList.add('active');
          track.appendChild(slide);
        }
      }
      function go(dir) {
        center = (center + dir + total) % total;
        renderSlides();
      }
      prevBtn.addEventListener('click', function() { go(-1); });
      nextBtn.addEventListener('click', function() { go(1); });
      // Init
      if (total === 1) center = 0;
      if (total === 2) center = 0;
      renderSlides();
      window.addEventListener('resize', renderSlides);
    })();
  </script>
</section> 