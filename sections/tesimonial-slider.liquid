{% comment %}
  Testimonial Slider Section
{% endcomment %}
<section class="testimonial-slider-section">
  <div class="testimonial-slider">
    <button class="slider-arrow slider-arrow--prev" aria-label="Previous">&#8592;</button>
    <div class="testimonial-slider__track">
      {% assign testimonials = section.blocks %}
      {% for block in testimonials %}
        <div class="testimonial-slide" {{ block.shopify_attributes }}>
          <div class="testimonial-stars">★★★★★</div>
          <h3 class="testimonial-title">{{ block.settings.title }}</h3>
          <p class="testimonial-text">{{ block.settings.text }}</p>
          <div class="testimonial-author">
            <strong>{{ block.settings.author }}</strong>
            <span class="verified">✔ Verified Buyer</span>
          </div>
        </div>
      {% endfor %}
    </div>
    <button class="slider-arrow slider-arrow--next" aria-label="Next">&#8594;</button>
  </div>
</section>

{% schema %}
{
  "name": "Testimonial Slider",
  "max_blocks": 10,
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Better Focus"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Testimonial Text",
          "default": "My productivity at work has skyrocketed since I started using Everwood. It helps me stay sharp all day."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Eleri S."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonial Slider",
      "blocks": [
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}
{% endschema %}

<style>
.testimonial-slider {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin: 40px 0;
}
.testimonial-slider__track {
  display: flex;
  transition: transform 0.5s;
  width: 960px;
  overflow: hidden;
}
.testimonial-slide {
  min-width: 320px;
  margin: 0 10px;
  background: #a3c2be;
  border-radius: 16px;
  padding: 32px 24px;
  text-align: center;
  opacity: 0.6;
  transform: scale(0.9);
  transition: transform 0.3s, opacity 0.3s;
  color: #222;
  z-index: 1;
  display: none;
}
.testimonial-slide.active {
  background: #0a4d4d;
  color: #fff;
  opacity: 1;
  transform: scale(1.05);
  z-index: 2;
}
.testimonial-slide.visible {
  display: block;
}
.slider-arrow {
  background: #fff;
  border: none;
  border-radius: 50%;
  width: 36px;
  height: 36px;
  font-size: 1.5rem;
  cursor: pointer;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  z-index: 3;
}
.slider-arrow:focus { outline: 2px solid #0a4d4d; }
.testimonial-stars {
  font-size: 1.5rem;
  color: #ffe599;
  margin-bottom: 16px;
}
.testimonial-title {
  font-size: 1.3rem;
  font-weight: bold;
  margin-bottom: 12px;
}
.testimonial-text {
  font-size: 1rem;
  margin-bottom: 18px;
}
.testimonial-author {
  font-size: 1.1rem;
  font-weight: bold;
}
.verified {
  display: block;
  font-size: 0.9rem;
  font-weight: normal;
  color: #e0e0e0;
}
@media (max-width: 1000px) {
  .testimonial-slider__track { width: 100vw; }
  .testimonial-slide { min-width: 80vw; }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const track = document.querySelector('.testimonial-slider__track');
  if (!track) return;
  const slides = Array.from(track.children);
  const prevBtn = document.querySelector('.slider-arrow--prev');
  const nextBtn = document.querySelector('.slider-arrow--next');
  let current = 0; // Center slide index

  function updateSlider() {
    slides.forEach((slide, idx) => {
      slide.classList.remove('active', 'visible');
      if (
        idx === current ||
        idx === (current - 1 + slides.length) % slides.length ||
        idx === (current + 1) % slides.length
      ) {
        slide.classList.add('visible');
      }
      if (idx === current) {
        slide.classList.add('active');
      }
    });
  }

  function nextSlide() {
    current = (current + 1) % slides.length;
    updateSlider();
  }

  function prevSlide() {
    current = (current - 1 + slides.length) % slides.length;
    updateSlider();
  }

  nextBtn.addEventListener('click', nextSlide);
  prevBtn.addEventListener('click', prevSlide);

  // Initialize
  updateSlider();
});
</script> 